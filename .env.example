# Copy to .env.local (gitignored). Used only by `pnpm test:live` (read-only LD calls).
# Never commit real tokens. The app itself never reads this file; tokens are entered in the UI
# and kept in memory.
LD_API_TOKEN=
# Optional: LD instance (us | eu | federal). Default: us.
LD_INSTANCE=us
# Optional: project to probe. Default: the first project the token can see.
LD_PROJECT_KEY=

# `pnpm seed:posthog` (PLAN §22.5): writes the Acme Hog fixture into a PostHog project OF YOUR OWN.
# A personal API key with write scopes (feature_flag, cohort, scheduled_change, early_access_feature,
# experiment, survey) plus project:read and person:read. Never a customer's key.
POSTHOG_SEED_KEY=
POSTHOG_SEED_PROJECT_ID=
# Optional: https://us.posthog.com (default) or https://eu.posthog.com
POSTHOG_SEED_HOST=
# Optional: set to the project id to seed a project whose name does not contain "Acme Hog".
POSTHOG_SEED_ALLOW_PROJECT=
