{
  "name": "ld-migration-console",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @sslm/web dev",
    "build": "pnpm --filter @sslm/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run --project live",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures:generate": "pnpm --filter @sslm/demo-fixtures generate",
    "coverage:generate": "pnpm --filter @sslm/coverage generate",
    "test:live:write": "LIVE=1 LIVE_WRITE=1 vitest run --project live",
    "seed:posthog": "pnpm --filter @sslm/demo-fixtures seed:posthog"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
